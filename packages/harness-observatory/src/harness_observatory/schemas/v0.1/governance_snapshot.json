{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "governance_snapshot_id": {
      "type": "string"
    },
    "repo_sha": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "missing_optional": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "const": "declared_candidates"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "required": [
    "schema_version",
    "governance_snapshot_id",
    "repo_sha",
    "documents",
    "missing_optional",
    "coverage",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "source": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "extractor": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source",
        "method",
        "confidence",
        "evidence_refs",
        "extractor"
      ],
      "additionalProperties": false
    }
  }
}
